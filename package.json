{
  "name": "desktop-buddy",
  "version": "1.2.0",
  "description": "Un pequeño compañero curioso que vive en tu escritorio",
  "main": "main.js",
  "author": "Desktop Buddy",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-packager . DesktopBuddy --platform=win32 --arch=x64 --out=dist --overwrite --no-prune && electron-builder --win --x64 --prepackaged dist/DesktopBuddy-win32-x64",
    "pack": "electron-packager . DesktopBuddy --platform=win32 --arch=x64 --out=dist --overwrite --no-prune",
    "release": "electron-builder --win --x64 --publish always"
  },
  "build": {
    "appId": "com.desktopbuddy.app",
    "productName": "Desktop Buddy",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": null,
      "uninstallerIcon": null,
      "license": null
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.html",
      "renderer.js",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "Nozdormv",
      "repo": "desktop-buddy",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
